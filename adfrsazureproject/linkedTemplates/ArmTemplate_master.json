{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfrsazureproject"
		},
		"ls_dlforsuperstoredata_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_dlforsuperstoredata'"
		},
		"ls_saforsuperstoredata_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_saforsuperstoredata'"
		},
		"ds_superstoredata_sqldb_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ds_superstoredata_sqldb'"
		},
		"ls_dlforsuperstoredata_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dlsriniazureproject.dfs.core.windows.net/"
		},
		"ds_superstoredata_sqldb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserver-azureproject.database.windows.net"
		},
		"ds_superstoredata_sqldb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db"
		},
		"ds_superstoredata_sqldb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "srini"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfrsazureproject_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_dlforsuperstoredata_accountKey": {
						"value": "[parameters('ls_dlforsuperstoredata_accountKey')]"
					},
					"ls_saforsuperstoredata_connectionString": {
						"value": "[parameters('ls_saforsuperstoredata_connectionString')]"
					},
					"ds_superstoredata_sqldb_password": {
						"value": "[parameters('ds_superstoredata_sqldb_password')]"
					},
					"ls_dlforsuperstoredata_properties_typeProperties_url": {
						"value": "[parameters('ls_dlforsuperstoredata_properties_typeProperties_url')]"
					},
					"ds_superstoredata_sqldb_properties_typeProperties_server": {
						"value": "[parameters('ds_superstoredata_sqldb_properties_typeProperties_server')]"
					},
					"ds_superstoredata_sqldb_properties_typeProperties_database": {
						"value": "[parameters('ds_superstoredata_sqldb_properties_typeProperties_database')]"
					},
					"ds_superstoredata_sqldb_properties_typeProperties_userName": {
						"value": "[parameters('ds_superstoredata_sqldb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}